[gd_resource type="BehaviorTree" format=3 uid="uid://cidle0deposit"]

[ext_resource type="BehaviorTree" uid="uid://blu1yawwyggvq" path="res://runtime/backend/entities/ai/shed_load.tres" id="1_shed"]
[ext_resource type="Script" uid="uid://sv2nw47pglic" path="res://runtime/backend/entities/ai/tasks/wander_task.gd" id="4_wander"]

[sub_resource type="BlackboardPlan" id="BlackboardPlan_idle"]

[sub_resource type="BlackboardPlan" id="BlackboardPlan_kkr6p"]

[sub_resource type="BTSubtree" id="BTSubtree_shed"]
subtree = ExtResource("1_shed")
blackboard_plan = SubResource("BlackboardPlan_kkr6p")

[sub_resource type="BTAction" id="BTAction_wander"]
script = ExtResource("4_wander")

[sub_resource type="BTSequence" id="BTSequence_idle"]
children = [SubResource("BTSubtree_shed"), SubResource("BTAction_wander")]

[sub_resource type="BTRepeat" id="BTRepeat_root"]
forever = true
children = [SubResource("BTSequence_idle")]

[resource]
description = "空闲树(循环):根是 BTRepeat(forever = true),每轮依次执行 共享卸货子树(shed_load.tres:从随身仓里挑第一类现在用不上的物品 —— 工具看\"持有太久没被用上\"、散料闲置即可卸 —— 找最近且收得下的已注册仓,走到装卸点(deposit_access,不设到达半径,精确站上容器)搬进去;能卸就卸,无可卸或全图无处可收时整条卸货链失败、被 BTAlwaysSucceed 装饰器吞掉,不做任何动作继续往下走)→ 原地游荡(WanderTask 跑满 duration 秒后返回 SUCCESS,把控制权交还外层 BTRepeat)。如此循环往复:卸货、游荡、再卸货……卸货判定每轮都重跑,工人不会把\"后来用不上\"的工具一直卡在手上;空闲期间这棵树刻意永不结束(工人被派活时由 LaborManager 经 begin_tree() 换成任务树,不依赖本树结束,故无旧版\"跑满 duration 就结束重建\"的周期性重建开销)。参数经工人黑板传:&deposit_type / &deposit_bag / &deposit_access / &wander_anchor。"
blackboard_plan = SubResource("BlackboardPlan_idle")
root_task = SubResource("BTRepeat_root")
